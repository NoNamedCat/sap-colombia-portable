# --- DIAN ---
# mock | real
SAP_DIAN_MODE=mock
# Solo en modo real:
# SAP_DIAN_USER=
# SAP_DIAN_PASSWORD=
# SAP_DIAN_TRANSMIT_URL=https://facturae.dian.gov.co/Services/Documentos/TransmitDocuments
# SAP_DIAN_TIMEOUT=60

# --- Seguridad ---
# Secreto JWT (si se omite se genera y persiste en la BD).
# Generar uno con:  python -c "import secrets; print(secrets.token_hex(32))"
# SAP_JWT_SECRET=

# --- Limitación de fuerza bruta ---
# Máximo de intentos fallidos por (IP, usuario) en la ventana de 300 s.
# 0 desactiva el límite (útil en la suite de pruebas).
SAP_LOGIN_MAX_INTENTOS=5

# --- PostgreSQL ---
SAP_DB_HOST=localhost
SAP_DB_PORT=5432
SAP_DB_USER=sap
SAP_DB_PASSWORD=sap
SAP_DB_NAME=sap_colombia

# --- Servidor ---
SAP_HOST=0.0.0.0
SAP_PORT=8080
